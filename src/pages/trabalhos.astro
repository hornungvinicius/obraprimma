---
import Base from '../layouts/Base.astro';
import Peca from '../components/Peca.astro';
import { obras, categorias, contaCategoria, total } from '../data/obras';
import { site } from '../data/site';
---

<Base
  title="Trabalhos | Obra Primma Molduraria, Ponta Grossa"
  description="Reproduções de pintura, fotografias, gravuras e objetos impressos e emoldurados pela Obra Primma, em Ponta Grossa, PR."
>
  <section class="topo pag">
    <h1 class="display">
      <span data-entra="linha"><span>Trabalhos<sup class="contagem">({total})</sup></span></span>
    </h1>
  </section>

  <section class="galeria pag" aria-label="Galeria de trabalhos">
    <div class="filtro" role="group" aria-label="Filtrar por tipo" data-entra="texto">
      <button type="button" class="rotulo" aria-pressed="true" data-filtro="todos">Todos ({total})</button>
      {
        categorias.map((c) => (
          <button type="button" class="rotulo" aria-pressed="false" data-filtro={c.id}>
            {c.nome} ({String(contaCategoria(c.id)).padStart(2, '0')})
          </button>
        ))
      }
      <a class="lk filtro__ig" href={site.instagram.url} rel="noopener">Mais no Instagram</a>
    </div>

    <div class="grade">
      {obras.map((o, i) => <Peca obra={o} tom={i % 3} />)}
    </div>
  </section>
</Base>

<script>
  import { gsap } from 'gsap';
  import { Flip } from 'gsap/Flip';
  gsap.registerPlugin(Flip);

  const botoes = document.querySelectorAll<HTMLButtonElement>('[data-filtro]');
  const pecas = document.querySelectorAll<HTMLElement>('.grade .peca');
  const calmo = matchMedia('(prefers-reduced-motion: reduce)').matches;

  botoes.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filtro;
      botoes.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const estado = Flip.getState(pecas);
      pecas.forEach((p) => {
        p.hidden = f !== 'todos' && p.dataset.categoria !== f;
      });
      if (calmo) return;
      Flip.from(estado, {
        duration: 0.6,
        ease: 'expo.inOut',
        absolute: true,
        onEnter: (els) => gsap.fromTo(els, { opacity: 0 }, { opacity: 1, duration: 0.4 }),
        onLeave: (els) => gsap.to(els, { opacity: 0, duration: 0.25 }),
      });
    }),
  );
</script>

<style>
  .topo {
    padding-block: clamp(8px, 2vw, 24px) clamp(24px, 3vw, 48px);
  }
  .filtro {
    display: flex;
    flex-wrap: wrap;
    gap: 0 clamp(16px, 2.4vw, 36px);
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--gap);
  }
  .filtro button {
    background: none;
    border: 0;
    padding: 0;
    min-height: 44px;
    color: var(--mid);
    cursor: pointer;
  }
  .filtro button:hover,
  .filtro button[aria-pressed='true'] {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .filtro__ig {
    margin-left: auto;
  }
  .grade {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(28px, 3vw, 48px) var(--gap);
    padding-bottom: clamp(80px, 10vw, 160px);
  }
  .grade :global(.peca[hidden]) {
    display: none;
  }
  @media (max-width: 1100px) {
    .grade {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 760px) {
    .grade {
      grid-template-columns: repeat(2, 1fr);
    }
    .filtro__ig {
      margin-left: 0;
    }
  }
</style>
