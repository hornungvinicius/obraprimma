---
import Base from '../layouts/Base.astro';
import Confirmar from '../components/Confirmar.astro';
import { site } from '../data/site';

const servicos = [
  { nome: 'Impressão', texto: 'Reprodução de pintura, fotografia e arte, em tela ou em papel, no tamanho que você precisar.', confirmar: true },
  { nome: 'Moldura sob medida', texto: 'Cortada e montada na loja, escolhida com a obra encostada nas amostras.' },
  { nome: 'Passe-partout e vidro', texto: 'Para gravura, aquarela, foto e documento.', confirmar: true },
  { nome: 'Tela em caixa', texto: 'Reprodução em tela montada em moldura caixa.' },
  { nome: 'Espelhos', texto: 'Espelho com moldura, no tamanho da parede.', confirmar: true },
];
---

<Base
  title="Sobre | Obra Primma Molduraria, Ponta Grossa"
  description="A Obra Primma é uma molduraria tradicional de Ponta Grossa, PR. Impressão e moldura feitas na loja."
>
  <section class="topo pag">
    <h1 class="display"><span data-entra="linha"><span>Sobre</span></span></h1>
  </section>

  <section class="texto pag" aria-label="A loja">
    <p class="rotulo">A loja</p>
    <div>
      <p class="grande" data-entra="texto">
        A Obra Primma é uma molduraria de Ponta Grossa. Quem chega com uma foto, um pôster ou só um arquivo no
        celular sai com o quadro pronto: a impressão e a moldura são feitas aqui.
      </p>
      <dl class="fichas regua" data-entra="texto">
        <div><dt class="rotulo cinza">Cidade</dt><dd>{site.cidade}, {site.uf}</dd></div>
        <div><dt class="rotulo cinza">Desde</dt><dd>Ano a definir <Confirmar /></dd></div>
        <div><dt class="rotulo cinza">Serviço</dt><dd>Impressão e moldura</dd></div>
      </dl>
    </div>
  </section>

  <div class="pag"><div class="larga" data-entra="imagem"></div></div>

  <section class="historia pag" aria-labelledby="historia-titulo">
    <h2 id="historia-titulo" class="rotulo">História</h2>
    <div class="historia__col">
      <p>
        [Ano de abertura, quem começou a loja, de onde veio o nome e o que mudou de lá para cá.]
        <Confirmar nota="Texto a escrever com o dono" />
      </p>
      <p>
        O trabalho segue o mesmo jeito de sempre: a obra vai para a bancada, a moldura é escolhida com ela
        encostada na amostra, depois corte, montagem e entrega.
      </p>
    </div>
    <div class="historia__img"></div>
  </section>

  <section class="serv pag" aria-labelledby="serv-titulo">
    <div class="barra">
      <h2 id="serv-titulo" class="rotulo">O que a loja faz</h2>
      <a class="lk" href="/trabalhos/">Ver trabalhos</a>
    </div>
    <ol>
      {
        servicos.map((s, i) => (
          <li>
            <span class="rotulo">{String(i + 1).padStart(2, '0')}.</span>
            <h3>{s.nome}</h3>
            <p class="cinza">
              {s.texto}
              {s.confirmar && <Confirmar />}
            </p>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .topo {
    padding-block: clamp(8px, 2vw, 24px) clamp(40px, 6vw, 96px);
  }
  .texto,
  .historia {
    display: grid;
    grid-template-columns: 3fr 9fr;
    gap: 24px;
  }
  .texto .grande {
    max-width: 26em;
  }
  .fichas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: clamp(40px, 5vw, 72px) 0 0;
    padding-top: 12px;
  }
  .fichas dd {
    margin: 4px 0 0;
    font-weight: 500;
  }
  .larga {
    aspect-ratio: 21 / 9;
    background: #cfcfca;
    margin-block: clamp(64px, 9vw, 140px);
  }
  .historia {
    grid-template-columns: 3fr 4fr 5fr;
    align-items: start;
  }
  .historia__col {
    display: grid;
    gap: 1em;
    max-width: 38ch;
  }
  .historia__img {
    aspect-ratio: 4 / 5;
    background: #d6d6d1;
  }
  .serv {
    padding-block: clamp(96px, 12vw, 200px);
  }
  .barra {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--ink);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 3fr 4fr 5fr;
    gap: 16px 24px;
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  h3 {
    font-size: clamp(1.25rem, 2vw, 1.8rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  @media (max-width: 900px) {
    .texto,
    .historia {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .fichas {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .larga {
      aspect-ratio: 4 / 3;
    }
  }
</style>
