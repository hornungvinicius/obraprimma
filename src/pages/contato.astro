---
import Base from '../layouts/Base.astro';
import Loja from '../components/Loja.astro';
import { site } from '../data/site';

const levar = [
  ['A peça ou o arquivo', 'Foto em papel, pôster, gravura, tela. Para imprimir, o arquivo no maior tamanho que você tiver.'],
  ['A medida do lugar', 'Largura da parede ou do espaço sobre o móvel. Ajuda a decidir o tamanho da impressão e da moldura.'],
  ['Uma foto da parede', 'Com luz do dia, para ver a cor do ambiente junto com as amostras.'],
];
---

<Base
  title="Contato | Obra Primma Molduraria, Ponta Grossa"
  description="Endereço, telefone e mapa da Obra Primma, molduraria em Ponta Grossa, PR."
>
  <section class="topo pag">
    <h1 class="display"><span data-entra="linha"><span>Contato</span></span></h1>
  </section>

  <Loja titulo={false} />

  <section class="levar pag" aria-labelledby="levar-titulo">
    <div class="barra">
      <h2 id="levar-titulo" class="rotulo">O que levar na primeira visita</h2>
      <a class="lk" href={site.telefoneLink}>Ligar para a loja</a>
    </div>
    <ol>
      {
        levar.map(([t, p]) => (
          <li>
            <h3>{t}</h3>
            <p class="cinza">{p}</p>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .topo {
    padding-top: clamp(8px, 2vw, 24px);
  }
  .topo + :global(.loja) {
    padding-top: clamp(24px, 3vw, 48px);
  }
  .levar {
    padding-bottom: clamp(96px, 12vw, 200px);
  }
  .barra {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--ink);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 16px 24px;
    align-items: baseline;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  h3 {
    font-size: clamp(1.25rem, 2vw, 1.8rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  @media (max-width: 600px) {
    li {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }
</style>
