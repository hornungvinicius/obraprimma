---
import Base from '../layouts/Base.astro';
import { creditos } from '../data/creditos';

const licencaUrl = (l: string, v: string | null) => `https://creativecommons.org/licenses/${l}/${v ?? '2.0'}/`;
const nomeLicenca = (l: string, v: string | null) => `CC ${l.toUpperCase()} ${v ?? ''}`.trim();
---

<Base title="Créditos das fotos | Obra Primma" description="Autoria e licença das fotos provisórias usadas no site da Obra Primma.">
  <section class="topo pag">
    <h1 class="display"><span data-entra="linha"><span>Créditos</span></span></h1>
  </section>

  <section class="lista pag" aria-label="Fotos e licenças">
    <div class="barra">
      <p class="rotulo">Fotos provisórias, de bancos de imagem com licença aberta</p>
      <p class="rotulo">{creditos.length} fotos</p>
    </div>
    <ul>
      {
        creditos.map((c) => (
          <li>
            <a href={c.pagina} rel="noopener">{c.titulo}</a>
            <span class="cinza">{c.autor}</span>
            <a class="cinza" href={licencaUrl(c.licenca, c.versao)} rel="noopener license">
              {nomeLicenca(c.licenca, c.versao)}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .topo {
    padding-block: clamp(8px, 2vw, 24px) clamp(24px, 3vw, 48px);
  }
  .lista {
    padding-bottom: clamp(96px, 12vw, 200px);
  }
  .barra {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 44px;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--line);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 4fr) minmax(0, 2fr);
    gap: 8px 24px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--t-legenda);
  }
  li a {
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  li a:hover {
    color: var(--vinho);
    text-decoration: underline;
  }
  @media (max-width: 760px) {
    li {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
  }
</style>
