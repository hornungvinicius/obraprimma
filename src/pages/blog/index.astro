---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.rascunho)).sort(
  (a, b) => b.data.data.getTime() - a.data.data.getTime(),
);
const dataCurta = (d: Date) =>
  d.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' });
---

<Base
  title="Blog | Obra Primma Molduraria, Ponta Grossa"
  description="Moldura, vidro, passe-partout e impressão: perguntas do balcão de uma molduraria em Ponta Grossa, PR."
>
  <section class="topo pag">
    <h1 class="display"><span data-entra="linha"><span>Blog</span></span></h1>
  </section>

  <section class="lista pag" aria-label="Posts">
    <div class="barra">
      <p class="rotulo">Perguntas do balcão, respondidas com calma</p>
      <p class="rotulo">Posts ({String(posts.length).padStart(2, '0')})</p>
    </div>
    <ol>
      {
        posts.map((p, i) => (
          <li>
            <a href={`/blog/${p.id}/`}>
              <div class="miniatura" data-tom={i % 3} />
              <span class="rotulo">{String(i + 1).padStart(2, '0')}.</span>
              <span class="tit">
                <span class="tit__h">{p.data.titulo}</span>
                <span class="cinza">{p.data.descricao}</span>
              </span>
              <time class="rotulo cinza" datetime={p.data.data.toISOString()}>
                {dataCurta(p.data.data)}
              </time>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .topo {
    padding-block: clamp(8px, 2vw, 24px) clamp(24px, 3vw, 48px);
  }
  .lista {
    padding-bottom: clamp(96px, 12vw, 200px);
  }
  .barra {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 44px;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--line);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    border-bottom: 1px solid var(--line);
  }
  a {
    display: grid;
    grid-template-columns: 2fr 1fr 7fr 2fr;
    gap: 24px;
    align-items: start;
    padding: var(--gap) 0;
    text-decoration: none;
  }
  .miniatura {
    aspect-ratio: 4 / 3;
    background: #d6d6d1;
  }
  .miniatura[data-tom='1'] {
    background: #cbcbc6;
  }
  .miniatura[data-tom='2'] {
    background: #dfdfdb;
  }
  .tit {
    display: grid;
    gap: 10px;
    max-width: 40em;
  }
  .tit__h {
    font-size: clamp(1.3rem, 2.2vw, 2rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
    transition: opacity 0.2s;
  }
  a:hover .tit__h {
    opacity: 0.55;
  }
  time {
    justify-self: end;
  }
  @media (max-width: 760px) {
    a {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    time {
      justify-self: start;
    }
    .barra p:first-child {
      display: none;
    }
  }
</style>
