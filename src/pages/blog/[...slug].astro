---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.rascunho);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { titulo, descricao, data } = post.data;
const dataCurta = data.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
  timeZone: 'UTC',
});

const outros = (await getCollection('blog', ({ data }) => !data.rascunho))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.data.getTime() - a.data.data.getTime())
  .slice(0, 2);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: titulo,
  description: descricao,
  datePublished: data.toISOString(),
  inLanguage: 'pt-BR',
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  author: { '@type': 'Organization', name: 'Obra Primma Molduraria' },
  publisher: { '@id': new URL('/#loja', Astro.site).href },
};
---

<Base title={`${titulo} | Obra Primma`} description={descricao} type="article" schema={schema}>
  <article class="pag">
    <div class="barra">
      <a class="lk" href="/blog/">Blog</a>
      <time class="rotulo" datetime={data.toISOString()}>{dataCurta}</time>
    </div>
    <h1 class="art__tit" data-entra="texto">{titulo}</h1>
    <div class="art__img" data-entra="imagem"></div>
    <div class="art__corpo">
      <Content />
    </div>
  </article>

  {
    outros.length > 0 && (
      <aside class="outros pag" aria-labelledby="outros-titulo">
        <div class="barra">
          <h2 id="outros-titulo" class="rotulo">Outros posts</h2>
        </div>
        <ul>
          {outros.map((p) => (
            <li>
              <a href={`/blog/${p.id}/`}>{p.data.titulo}</a>
            </li>
          ))}
        </ul>
      </aside>
    )
  }
</Base>

<style>
  .barra {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--ink);
  }
  .art__tit {
    font-size: clamp(2.2rem, 5.2vw, 5.2rem);
    font-weight: 400;
    font-stretch: 106%;
    letter-spacing: -0.035em;
    line-height: 0.98;
    max-width: 16em;
    padding-block: clamp(32px, 5vw, 72px);
  }
  .art__img {
    border-radius: var(--raio);
    overflow: hidden;
    aspect-ratio: 21 / 9;
    background: var(--ph-hero);
  }
  .art__corpo {
    max-width: 680px;
    margin: clamp(48px, 6vw, 96px) 0 0 auto;
    margin-right: calc(100% / 12);
    font-size: 17px;
    line-height: 1.65;
  }
  .art__corpo :global(p) {
    margin-bottom: 1em;
  }
  .art__corpo :global(p:first-child) {
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .art__corpo :global(h2) {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    border-top: 1px solid var(--ink);
    padding-top: 10px;
    margin: 2.6em 0 1em;
  }
  .art__corpo :global(ul) {
    padding-left: 1.1em;
  }
  .outros {
    padding-block: clamp(96px, 12vw, 180px);
  }
  .outros ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .outros li {
    border-bottom: 1px solid var(--line);
  }
  .outros a {
    display: block;
    padding: 18px 0;
    font-size: clamp(1.15rem, 1.8vw, 1.6rem);
    letter-spacing: -0.015em;
    text-decoration: none;
  }
  .outros a:hover {
    color: var(--vinho);
  }
  @media (max-width: 900px) {
    .art__corpo {
      margin-inline: 0;
    }
    .art__img {
      aspect-ratio: 4 / 3;
    }
  }
</style>
