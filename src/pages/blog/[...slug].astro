---
import Base from '../../layouts/Base.astro';
import Quadro from '../../components/Quadro.astro';
import { getCollection, render } from 'astro:content';
import type { Moldura, Passe } from '../../data/obras';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.rascunho);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { titulo, descricao, data, quadro } = post.data;
const dataBR = data.toLocaleDateString('pt-BR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const outros = (await getCollection('blog', ({ data }) => !data.rascunho))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.data.getTime() - a.data.data.getTime())
  .slice(0, 2);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: titulo,
  description: descricao,
  datePublished: data.toISOString(),
  inLanguage: 'pt-BR',
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  author: { '@type': 'Organization', name: 'Obra Primma Molduraria' },
  publisher: { '@id': new URL('/#loja', Astro.site).href },
};
---

<Base title={`${titulo} | Obra Primma`} description={descricao} type="article" schema={schema}>
  <article class="artigo">
    <header class="wrap artigo__topo">
      <div>
        <p class="artigo__volta"><a class="link" href="/blog/">Blog</a></p>
        <h1 data-entra="texto">{titulo}</h1>
        <p class="artigo__data" data-entra="texto">
          <time datetime={data.toISOString()}>{dataBR}</time>
        </p>
      </div>
      {
        quadro && (
          <div class="artigo__quadro" data-entra="quadro">
            <Quadro
              arte={quadro.arte}
              moldura={quadro.moldura as Moldura}
              passe={quadro.passe as Passe}
              alt={quadro.alt}
              sizes="(max-width: 900px) 70vw, 28vw"
              eager
            />
          </div>
        )
      }
    </header>

    <div class="wrap">
      <div class="artigo__corpo">
        <Content />
      </div>
    </div>
  </article>

  {
    outros.length > 0 && (
      <aside class="outros" aria-labelledby="outros-titulo">
        <div class="wrap">
          <h2 id="outros-titulo">Outros posts</h2>
          <ul>
            {outros.map((p) => (
              <li>
                <a href={`/blog/${p.id}/`}>{p.data.titulo}</a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    )
  }
</Base>

<style>
  .artigo {
    padding-bottom: clamp(72px, 9vw, 130px);
  }
  .artigo__topo {
    display: grid;
    grid-template-columns: 8fr 4fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: end;
    padding-top: clamp(32px, 5vw, 80px);
    padding-bottom: clamp(48px, 6vw, 96px);
  }
  .artigo__volta {
    margin-bottom: 24px;
  }
  .artigo h1 {
    font-size: clamp(2.5rem, 5.6vw, 5rem);
    line-height: 1.04;
  }
  .artigo__data {
    margin-top: 24px;
    color: var(--tinta-2);
    font-size: 0.9rem;
  }
  .artigo__quadro {
    max-width: 360px;
    justify-self: end;
    width: 100%;
  }
  .artigo__corpo {
    max-width: 680px;
    margin-left: calc(100% / 12 * 2);
    font-family: var(--serif);
    font-size: 1.2rem;
    line-height: 1.65;
    border-top: 1px solid var(--linha);
    padding-top: 48px;
  }
  .artigo__corpo :global(h2) {
    font-family: var(--display);
    font-size: clamp(1.8rem, 2.8vw, 2.3rem);
    margin: 1.8em 0 0.6em;
  }
  .artigo__corpo :global(p:first-child) {
    font-size: 1.35rem;
    line-height: 1.5;
  }
  .artigo__corpo :global(ul) {
    padding-left: 1.2em;
  }
  .artigo__corpo :global(li) {
    margin-bottom: 0.4em;
  }
  .outros {
    background: var(--papel-2);
    padding: clamp(56px, 7vw, 100px) 0;
  }
  .outros h2 {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    margin-bottom: 24px;
  }
  .outros ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .outros li {
    border-top: 1px solid var(--linha);
  }
  .outros a {
    display: block;
    padding: 18px 0;
    font-family: var(--serif);
    font-size: 1.35rem;
    text-decoration: none;
  }
  .outros a:hover {
    color: var(--sangue);
  }
  @media (max-width: 900px) {
    .artigo__topo {
      grid-template-columns: 1fr;
    }
    .artigo__quadro {
      justify-self: start;
      max-width: 260px;
    }
    .artigo__corpo {
      margin-left: 0;
      font-size: 1.1rem;
    }
  }
</style>
