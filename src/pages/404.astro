---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada | Obra Primma" description="Essa página não existe no site da Obra Primma.">
  <section class="pag nao">
    <h1 class="display">404</h1>
    <div class="barra">
      <p class="rotulo">Essa página não existe ou mudou de lugar</p>
      <a class="lk" href="/">Voltar para o início</a>
    </div>
  </section>
</Base>

<style>
  .nao {
    min-height: 60vh;
    padding-block: clamp(8px, 2vw, 24px) 120px;
  }
  .barra {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 24px;
    border-top: 1px solid var(--ink);
    margin-top: 24px;
  }
</style>
