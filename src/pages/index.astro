---
import Base from '../layouts/Base.astro';
import Peca from '../components/Peca.astro';
import Loja from '../components/Loja.astro';
import Confirmar from '../components/Confirmar.astro';
import Carrossel from '../components/Carrossel.astro';
import { obras } from '../data/obras';
import { site } from '../data/site';
import { getCollection } from 'astro:content';

const grade = obras.slice(0, 6);
const destaques = obras.slice(6, 10);

const posts = (await getCollection('blog', ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data.getTime() - a.data.data.getTime())
  .slice(0, 3);
const dataCurta = (d: Date) =>
  d.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' });
---

<Base
  title="Obra Primma Molduraria | Molduras e impressão em Ponta Grossa"
  description="Molduraria em Ponta Grossa, PR. Impressão de reprodução de pintura, fotografia e gravura, e moldura feita na loja."
>
  <section class="hero pag">
    <div class="hero__box" data-entra="imagem">
      <div class="hero__texto">
        <h1 class="hero__titulo display">
          <span data-entra="linha"><span>Obra <em>Primma</em></span></span>
        </h1>
        <div class="hero__base" data-entra="texto">
          <p class="hero__frase">
            Molduraria em {site.cidade}: impressão e moldura feitas aqui na loja.
          </p>
          <a class="botao botao--claro" href="/trabalhos/">Ver os trabalhos</a>
        </div>
      </div>
    </div>
  </section>

  <section class="sel pag" aria-labelledby="sel-titulo">
    <div class="barra">
      <h2 id="sel-titulo" class="rotulo">Trabalhos selecionados</h2>
    </div>
    <div class="sel__grade">
      {grade.map((o, i) => <Peca obra={o} tom={i % 3} />)}
    </div>
  </section>

  <section class="dest pag" aria-labelledby="dest-titulo">
    <div class="dest__topo">
      <h2 id="dest-titulo" class="titulo">Da bancada</h2>
      <p class="cinza">Peças grandes, de parede inteira, impressas e montadas na loja.</p>
    </div>
    <div class="dest__grade">
      {
        destaques.map((o, i) => (
          <Peca obra={o} proporcao="5 / 4" tom={(i + 1) % 3} />
        ))
      }
    </div>
  </section>

  <div class="todos pag">
    <a class="botao" href="/trabalhos/">Ver todos os projetos</a>
  </div>

  <Carrossel />

  <section class="sobre pag" aria-labelledby="sobre-titulo">
    <div class="sobre__texto">
      <h2 id="sobre-titulo" class="titulo">Sobre a loja</h2>
      <p class="grande">
        A Obra Primma é uma molduraria de {site.cidade}. Quem chega com uma foto, um pôster ou só um arquivo
        no celular sai com o quadro pronto: a impressão e a moldura são feitas aqui.
      </p>
      <p class="cinza">
        A moldura é escolhida com a obra encostada nas amostras, depois vem o corte, a montagem e a
        entrega. Desde <Confirmar nota="Ano de abertura não encontrado em fonte pública" />.
      </p>
      <a class="lk" href="/sobre/">Mais sobre a loja</a>
    </div>
    <div class="sobre__img" role="img" aria-label="Foto da loja (a definir)"></div>
  </section>

  <section class="blog pag" aria-labelledby="blog-titulo">
    <div class="barra">
      <h2 id="blog-titulo" class="rotulo">Blog</h2>
      <a class="lk" href="/blog/">Todos os posts</a>
    </div>
    <ol class="blog__lista">
      {
        posts.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`}>
              <span class="blog__tit">{p.data.titulo}</span>
              <time class="rotulo cinza" datetime={p.data.data.toISOString()}>
                {dataCurta(p.data.data)}
              </time>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <Loja />
</Base>

<style>
  .hero {
    padding-bottom: var(--g);
  }
  .hero__box {
    position: relative;
    height: calc(100svh - var(--topo) - var(--g));
    min-height: 520px;
    border-radius: var(--raio);
    background: var(--ph-hero);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }
  .hero__texto {
    width: 100%;
    padding: clamp(20px, 3vw, 44px);
  }
  .hero__titulo {
    color: var(--ink);
  }
  .hero__base {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px 40px;
    flex-wrap: wrap;
    margin-top: clamp(16px, 2vw, 32px);
  }
  .hero__frase {
    max-width: 34em;
    color: var(--ink);
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    line-height: 1.35;
  }

  .barra {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--ink);
    margin-bottom: var(--gap);
  }

  .sel {
    padding-top: clamp(48px, 6vw, 96px);
  }
  .sel__grade {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 3vw, 48px) var(--gap);
  }

  .dest {
    padding-top: clamp(96px, 12vw, 200px);
  }
  .dest__topo {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px 40px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 12px;
    margin-bottom: var(--gap);
  }
  .dest__topo p {
    max-width: 30ch;
  }
  .dest__grade {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(32px, 4vw, 64px) var(--gap);
  }

  .todos {
    display: flex;
    justify-content: center;
    padding-top: clamp(56px, 7vw, 104px);
  }

  .sobre {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    padding-top: clamp(96px, 12vw, 200px);
  }
  .sobre__texto {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .sobre__img {
    aspect-ratio: 4 / 5;
    border-radius: var(--raio);
    background: var(--ph-hero);
  }

  .blog {
    padding-top: clamp(96px, 12vw, 200px);
  }
  .blog__lista {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .blog__lista li {
    border-bottom: 1px solid var(--line);
  }
  .blog__lista a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px;
    align-items: baseline;
    padding: 20px 0;
    text-decoration: none;
  }
  .blog__tit {
    font-size: clamp(1.15rem, 1.8vw, 1.6rem);
    letter-spacing: -0.015em;
    line-height: 1.3;
    transition: opacity 0.2s;
  }
  .blog__lista a:hover .blog__tit {
    color: var(--vinho);
  }
  .blog__lista time {
    justify-self: end;
  }

  @media (max-width: 900px) {
    .sel__grade {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .sobre {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 760px) {
    .hero__box {
      height: auto;
      min-height: calc(100svh - var(--topo) - 80px);
    }
    .dest__grade {
      grid-template-columns: minmax(0, 1fr);
    }
    .blog__lista a {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
    .blog__lista time {
      justify-self: start;
    }
  }
</style>
