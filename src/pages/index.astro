---
import Base from '../layouts/Base.astro';
import Peca from '../components/Peca.astro';
import Loja from '../components/Loja.astro';
import Confirmar from '../components/Confirmar.astro';
import { obras, total } from '../data/obras';
import { site } from '../data/site';
import { getCollection } from 'astro:content';

const grade = obras.slice(0, 6);
const destaques = obras.slice(6, 10);

const posts = (await getCollection('blog', ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data.getTime() - a.data.data.getTime())
  .slice(0, 3);
const dataCurta = (d: Date) =>
  d.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' });
---

<Base
  title="Obra Primma Molduraria | Molduras e impressão em Ponta Grossa"
  description="Molduraria em Ponta Grossa, PR. Impressão de reprodução de pintura, fotografia e gravura, e moldura feita na loja."
>
  <section class="hero pag">
    <h1 class="hero__titulo display">
      <span class="sr-only">Obra Primma, molduraria em Ponta Grossa</span>
      <span data-entra="linha" aria-hidden="true"><span>Obra</span></span>
      <span data-entra="linha" aria-hidden="true" class="hero__dir"><span><em>Primma</em></span></span>
    </h1>
    <div class="hero__img" data-entra="imagem"></div>
    <div class="hero__meta regua" data-entra="texto">
      <p class="rotulo">Impressão e moldura</p>
      <a class="lk" href="/trabalhos/">Trabalhos ({total})</a>
      <p class="rotulo">{site.cidade}, {site.uf}</p>
    </div>
  </section>

  <section class="intro pag" aria-labelledby="intro-titulo">
    <h2 id="intro-titulo" class="rotulo">A loja</h2>
    <div>
      <p class="grande">
        A gente imprime a obra e faz a moldura, as duas coisas aqui na loja. Reprodução de pintura, foto de
        família, gravura, o que você trouxer.
      </p>
      <dl class="fichas regua">
        <div><dt class="rotulo cinza">Cidade</dt><dd>{site.cidade}, {site.uf}</dd></div>
        <div><dt class="rotulo cinza">Serviço</dt><dd>Impressão e moldura sob medida</dd></div>
        <div><dt class="rotulo cinza">Desde</dt><dd>Ano a definir <Confirmar /></dd></div>
      </dl>
    </div>
  </section>

  <section class="sel pag" aria-labelledby="sel-titulo">
    <div class="barra">
      <h2 id="sel-titulo" class="rotulo">Trabalhos selecionados</h2>
      <a class="lk" href="/trabalhos/">Ver todos ({total})</a>
    </div>
    <div class="sel__grade">
      {grade.map((o, i) => <Peca obra={o} tom={i % 3} />)}
    </div>
  </section>

  <section class="dest pag" aria-labelledby="dest-titulo">
    <div class="dest__topo">
      <h2 id="dest-titulo" class="titulo">Da <em>bancada</em></h2>
      <p class="cinza">Peças grandes, de parede inteira, impressas e montadas na loja.</p>
    </div>
    <div class="dest__grade">
      {
        destaques.map((o, i) => (
          <Peca obra={o} proporcao="5 / 4" numero={`${o.slug.slice(-2)} / ${total}`} tom={(i + 1) % 3} />
        ))
      }
    </div>
  </section>

  <section class="blog pag" aria-labelledby="blog-titulo">
    <div class="barra">
      <h2 id="blog-titulo" class="rotulo">Blog</h2>
      <a class="lk" href="/blog/">Todos os posts</a>
    </div>
    <ol class="blog__lista">
      {
        posts.map((p, i) => (
          <li>
            <a href={`/blog/${p.id}/`}>
              <span class="rotulo">{String(i + 1).padStart(2, '0')}.</span>
              <span class="blog__tit">{p.data.titulo}</span>
              <time class="rotulo cinza" datetime={p.data.data.toISOString()}>
                {dataCurta(p.data.data)}
              </time>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <Loja />
</Base>

<style>
  .hero {
    min-height: calc(100svh - var(--topo));
    display: flex;
    flex-direction: column;
    padding-bottom: var(--g);
  }
  .hero__titulo {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 0.2em;
    padding-top: clamp(8px, 2vw, 24px);
  }
  .hero__img {
    flex: 1;
    min-height: 260px;
    margin-top: clamp(12px, 1.6vw, 24px);
    background: #cfcfca;
  }
  .hero__meta {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    margin-top: 10px;
  }
  .hero__meta p:last-child {
    justify-self: end;
  }

  .intro {
    display: grid;
    grid-template-columns: 3fr 9fr;
    gap: 24px;
    padding-block: clamp(72px, 10vw, 160px);
  }
  .intro .grande {
    max-width: 26em;
  }
  .fichas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: clamp(40px, 5vw, 72px) 0 0;
    padding-top: 12px;
  }
  .fichas dt {
    margin-bottom: 4px;
  }
  .fichas dd {
    margin: 0;
    font-weight: 500;
  }

  .barra {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--ink);
    margin-bottom: var(--gap);
  }

  .sel__grade {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(28px, 3vw, 48px) var(--gap);
  }

  .dest {
    padding-top: clamp(96px, 12vw, 200px);
  }
  .dest__topo {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px 40px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 12px;
    margin-bottom: var(--gap);
  }
  .dest__topo p {
    max-width: 30ch;
  }
  .dest__grade {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(32px, 4vw, 64px) var(--gap);
  }

  .blog {
    padding-top: clamp(96px, 12vw, 200px);
  }
  .blog__lista {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .blog__lista li {
    border-bottom: 1px solid var(--line);
  }
  .blog__lista a {
    display: grid;
    grid-template-columns: 3fr 7fr 2fr;
    gap: 16px;
    align-items: baseline;
    padding: 18px 0;
    text-decoration: none;
  }
  .blog__tit {
    font-size: clamp(1.15rem, 1.8vw, 1.6rem);
    letter-spacing: -0.015em;
    line-height: 1.2;
    transition: opacity 0.2s;
  }
  .blog__lista a:hover .blog__tit {
    opacity: 0.55;
  }
  .blog__lista time {
    justify-self: end;
  }

  @media (max-width: 900px) {
    .intro {
      grid-template-columns: 1fr;
    }
    .sel__grade {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 760px) {
    .hero {
      min-height: auto;
    }
    .hero__titulo {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .hero__dir {
      text-align: right;
    }
    .hero__img {
      flex: none;
      aspect-ratio: 4 / 5;
    }
    .hero__meta {
      grid-template-columns: 1fr 1fr;
    }
    .hero__meta .lk {
      display: none;
    }
    .fichas {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .dest__grade {
      grid-template-columns: 1fr;
    }
    .blog__lista a {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .blog__lista time {
      justify-self: start;
    }
  }
</style>
