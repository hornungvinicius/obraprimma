---
import '../styles/global.css';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown>;
}

const { title, description, image, type = 'website', schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;

// Só entra no schema o que está confirmado.
const negocio: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  '@id': new URL('/#loja', Astro.site).href,
  name: site.nomeCompleto,
  description: 'Molduraria em Ponta Grossa, PR. Impressão de reproduções de pintura, fotografia e arte, e molduras feitas na loja.',
  url: Astro.site?.href,
  areaServed: ['Ponta Grossa', 'Campos Gerais'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.cidade,
    addressRegion: site.uf,
    addressCountry: 'BR',
    ...(site.endereco.confirmado ? { streetAddress: site.endereco.valor } : {}),
    ...(site.cep.confirmado ? { postalCode: site.cep.valor } : {}),
  },
  sameAs: [site.instagram.url, site.facebook.url],
  ...(site.telefone.confirmado ? { telephone: site.telefone.valor } : {}),
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f2f2ef" />
    <meta name="geo.region" content="BR-PR" />
    <meta name="geo.placename" content="Ponta Grossa" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.nomeCompleto} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <script is:inline>
      document.documentElement.classList.add('js');
      // se o script de animação falhar, nada fica escondido
      setTimeout(function () {
        document.documentElement.classList.add('js-ok');
      }, 2500);
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(negocio)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Cabecalho />
    <main id="conteudo">
      <slot />
    </main>
    <Rodape />
    <script>
      import '../scripts/entrada';
    </script>
  </body>
</html>
