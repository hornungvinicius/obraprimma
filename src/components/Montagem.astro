---
// Seção que mostra a montagem de um quadro conforme a página rola:
// a impressão sai, o passe-partout entra, os quatro lados da moldura fecham em 45 graus.
import { Image } from 'astro:assets';
import { img } from '../data/obras';

const arte = img('medas-de-trigo');
const passos = [
  {
    t: 'Impressão',
    p: 'A obra é impressa aqui, em tela ou em papel, no tamanho que a parede pede. Se veio uma foto velha, ela é escaneada antes.',
  },
  {
    t: 'Passe-partout',
    p: 'Trabalho em papel ganha passe-partout. Ele afasta a obra do vidro e dá respiro em volta da imagem.',
  },
  {
    t: 'Moldura',
    p: 'A régua é cortada em 45 graus e os cantos são colados e grampeados na bancada. Canto bom fecha sem fresta.',
  },
];
---

<section class="mont" aria-labelledby="mont-titulo" data-montagem>
  <div class="wrap mont__grade">
    <div class="mont__texto">
      <h2 id="mont-titulo">Como um quadro é montado</h2>
      <ol class="mont__passos">
        {
          passos.map((s, i) => (
            <li class="mont__passo" data-passo={i}>
              <span class="mont__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.t}</h3>
              <p>{s.p}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="mont__palco" aria-hidden="true">
      <div class="mont__quadro">
        <span class="mont__lado mont__lado--t"></span>
        <span class="mont__lado mont__lado--r"></span>
        <span class="mont__lado mont__lado--b"></span>
        <span class="mont__lado mont__lado--l"></span>
        <div class="mont__passe">
          <div class="mont__arte">
            <Image src={arte} alt="" widths={[560, 843]} sizes="(max-width: 900px) 90vw, 50vw" />
          </div>
        </div>
        <span class="mont__vidro"></span>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const sec = document.querySelector<HTMLElement>('[data-montagem]');
  if (sec) {
    const q = gsap.utils.selector(sec);
    const mm = gsap.matchMedia();

    mm.add('(min-width: 901px) and (prefers-reduced-motion: no-preference)', () => {
      sec.classList.add('mont--ativa');
      const passos = q('.mont__passo');
      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: sec,
          start: 'top top',
          end: '+=220%',
          scrub: 0.6,
          pin: true,
          anticipatePin: 1,
        },
      });

      gsap.set(passos, { opacity: 0.28 });
      gsap.set(passos[0], { opacity: 1 });

      // 1. impressão: a imagem sai de cima para baixo
      tl.fromTo(q('.mont__arte img'), { clipPath: 'inset(0 0 100% 0)' }, { clipPath: 'inset(0 0 0% 0)', duration: 1 })
        // 2. passe-partout
        .to(passos[0], { opacity: 0.28, duration: 0.15 }, '+=0.1')
        .to(passos[1], { opacity: 1, duration: 0.15 }, '<')
        .fromTo(q('.mont__passe'), { '--mat': '0%' }, { '--mat': '9%', duration: 0.8 }, '<')
        .fromTo(q('.mont__passe'), { backgroundColor: 'rgba(236,227,209,0)', boxShadow: 'inset 0 0 0 rgba(0,0,0,0)' }, { backgroundColor: 'rgba(236,227,209,1)', boxShadow: 'inset 1px 3px 6px -2px rgba(0,0,0,0.3)', duration: 0.5 }, '<')
        // 3. moldura: os quatro lados entram e fecham nos cantos
        .to(passos[1], { opacity: 0.28, duration: 0.15 }, '+=0.1')
        .to(passos[2], { opacity: 1, duration: 0.15 }, '<')
        .fromTo(q('.mont__lado--t'), { yPercent: -16, opacity: 0 }, { yPercent: 0, opacity: 1, duration: 0.7 }, '<')
        .fromTo(q('.mont__lado--b'), { yPercent: 16, opacity: 0 }, { yPercent: 0, opacity: 1, duration: 0.7 }, '<0.08')
        .fromTo(q('.mont__lado--l'), { xPercent: -10, opacity: 0 }, { xPercent: 0, opacity: 1, duration: 0.7 }, '<0.08')
        .fromTo(q('.mont__lado--r'), { xPercent: 10, opacity: 0 }, { xPercent: 0, opacity: 1, duration: 0.7 }, '<0.08')
        // vidro
        .fromTo(q('.mont__vidro'), { backgroundPosition: '-150% 0' }, { backgroundPosition: '250% 0', duration: 0.8 })
        .to({}, { duration: 0.2 });

      return () => sec.classList.remove('mont--ativa');
    });
  }
</script>

<style>
  .mont {
    padding: clamp(80px, 10vw, 140px) 0;
    background: var(--papel-2);
    overflow: hidden;
  }
  .mont--ativa {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 0;
  }
  .mont__grade {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .mont__passos {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
  }
  .mont__passo {
    display: grid;
    grid-template-columns: 2.8em 1fr;
    column-gap: 8px;
    padding: 18px 0;
    border-top: 1px solid var(--linha);
  }
  .mont__num {
    grid-row: span 2;
    font-family: var(--serif);
    font-style: italic;
    color: var(--sangue);
    padding-top: 2px;
  }
  .mont__passo h3 {
    margin-bottom: 6px;
  }
  .mont__passo p {
    margin: 0;
    max-width: 42ch;
    color: var(--tinta-2);
  }

  .mont__palco {
    display: flex;
    justify-content: center;
  }
  .mont__quadro {
    --w: clamp(16px, 2.6vw, 36px);
    position: relative;
    width: min(100%, 680px);
    padding: var(--w);
    filter: drop-shadow(0 30px 30px rgba(40, 26, 14, 0.28));
  }
  .mont__lado {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, #5a3e2b, #3e2a1d 60%, #4b3324);
  }
  .mont__lado--t {
    clip-path: polygon(0 0, 100% 0, calc(100% - var(--w)) var(--w), var(--w) var(--w));
    filter: brightness(1.25);
  }
  .mont__lado--r {
    clip-path: polygon(100% 0, 100% 100%, calc(100% - var(--w)) calc(100% - var(--w)), calc(100% - var(--w)) var(--w));
    filter: brightness(0.9);
  }
  .mont__lado--b {
    clip-path: polygon(0 100%, 100% 100%, calc(100% - var(--w)) calc(100% - var(--w)), var(--w) calc(100% - var(--w)));
    filter: brightness(0.72);
  }
  .mont__lado--l {
    clip-path: polygon(0 0, var(--w) var(--w), var(--w) calc(100% - var(--w)), 0 100%);
    filter: brightness(1.08);
  }
  .mont__passe {
    --mat: 9%;
    position: relative;
    padding: var(--mat);
    background: rgb(236, 227, 209);
    box-shadow: inset 1px 3px 6px -2px rgba(0, 0, 0, 0.3);
  }
  .mont__arte {
    background: #fbfaf6;
    box-shadow: 0 1px 3px rgba(40, 26, 14, 0.18);
  }
  .mont__arte :global(img) {
    display: block;
    width: 100%;
    height: auto;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.9);
  }
  .mont__vidro {
    position: absolute;
    inset: var(--w);
    pointer-events: none;
    background: linear-gradient(105deg, transparent 40%, rgba(255, 255, 255, 0.28) 48%, transparent 56%) no-repeat;
    background-size: 60% 100%;
    background-position: 250% 0;
  }

  @media (max-width: 900px) {
    .mont__grade {
      grid-template-columns: 1fr;
    }
  }
</style>
