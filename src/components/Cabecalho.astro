---
import { nav, site } from '../data/site';
const atual = Astro.url.pathname;
---

<header class="cab pag">
  <a href="/" class="cab__marca rotulo" aria-label="Obra Primma, página inicial">Obra Primma</a>
  <p class="cab__meio rotulo cinza">Molduraria · {site.cidade}, {site.uf}</p>

  <button class="cab__menu rotulo" type="button" aria-expanded="false" aria-controls="menu">Menu</button>

  <nav id="menu" class="cab__nav" aria-label="Principal">
    <ul>
      {
        nav.map((i) => (
          <li>
            <a class="rotulo" href={i.href} aria-current={atual.startsWith(i.href) ? 'page' : undefined}>
              {i.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const b = document.querySelector<HTMLButtonElement>('.cab__menu');
  b?.addEventListener('click', () => {
    const aberto = b.getAttribute('aria-expanded') === 'true';
    b.setAttribute('aria-expanded', String(!aberto));
    b.textContent = aberto ? 'Menu' : 'Fechar';
    document.documentElement.classList.toggle('menu-aberto', !aberto);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && b?.getAttribute('aria-expanded') === 'true') b.click();
  });
</script>

<style>
  .cab {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: var(--topo);
    position: relative;
    z-index: 30;
  }
  .cab__marca {
    justify-self: start;
    text-decoration: none;
    font-size: 12px;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .cab__nav {
    justify-self: end;
  }
  .cab__nav ul {
    display: flex;
    gap: clamp(16px, 2.4vw, 36px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cab__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  .cab__nav a:hover,
  .cab__nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cab__menu {
    display: none;
  }

  @media (max-width: 760px) {
    .cab {
      grid-template-columns: 1fr auto;
    }
    .cab__meio {
      display: none;
    }
    .cab__menu {
      display: inline-flex;
      align-items: center;
      justify-content: flex-end;
      min-height: 44px;
      min-width: 60px;
      background: none;
      border: 0;
      padding: 0;
      color: inherit;
      cursor: pointer;
      position: relative;
      z-index: 2;
    }
    .cab__marca {
      position: relative;
      z-index: 2;
    }
    .cab__nav {
      display: none;
      position: fixed;
      inset: 0;
      background: var(--bg);
      padding: calc(var(--topo) + 32px) var(--g) 32px;
    }
    :global(html.menu-aberto) {
      overflow: hidden;
    }
    :global(html.menu-aberto) .cab__nav {
      display: block;
    }
    .cab__nav ul {
      flex-direction: column;
      gap: 4px;
    }
    .cab__nav a {
      font-size: 13vw;
      font-weight: 400;
      font-stretch: 112%;
      letter-spacing: -0.04em;
      line-height: 1;
      min-height: 0;
      padding: 4px 0;
    }
  }
</style>
