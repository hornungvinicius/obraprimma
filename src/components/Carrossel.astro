---
// Carrossel de tipos de trabalho. Rolagem nativa com encaixe (funciona no dedo e no trackpad)
// e setas que andam um cartão por vez.
import { categorias, contaCategoria } from '../data/obras';

const itens: { href: string; nome: string; conta?: string }[] = [
  ...categorias.map((c) => ({
    href: `/trabalhos/#${c.id}`,
    nome: c.nome,
    conta: String(contaCategoria(c.id)).padStart(2, '0'),
  })),
  // [CONFIRMAR] tipos que molduraria costuma fazer; manter só os que a loja faz de verdade
  { href: '/trabalhos/', nome: 'Espelhos' },
  { href: '/trabalhos/', nome: 'Camisas de time' },
  { href: '/trabalhos/', nome: 'Diplomas e documentos' },
];
---

<section class="car" aria-labelledby="car-titulo">
  <div class="car__topo pag">
    <div class="car__cab">
      <h2 id="car-titulo" class="car__tit">O que você quer emoldurar?</h2>
      <p class="cinza">Veja os trabalhos por tipo de peça.</p>
    </div>
    <div class="car__setas">
      <button type="button" class="car__seta" data-dir="-1" aria-label="Anterior">←</button>
      <button type="button" class="car__seta" data-dir="1" aria-label="Próximo">→</button>
    </div>
  </div>

  <ul class="car__trilho pag" tabindex="0" aria-label="Tipos de trabalho">
    {
      itens.map((it, i) => (
        <li class="car__item">
          <a href={it.href}>
            <div class="car__img" data-tom={i % 3} />
            <span class="car__nome rotulo">
              {it.nome} {it.conta && <span class="cinza">({it.conta})</span>}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.car').forEach((car) => {
    const trilho = car.querySelector<HTMLElement>('.car__trilho')!;
    car.querySelectorAll<HTMLButtonElement>('.car__seta').forEach((b) =>
      b.addEventListener('click', () => {
        const item = trilho.querySelector<HTMLElement>('.car__item');
        const passo = item ? item.offsetWidth + parseFloat(getComputedStyle(trilho).columnGap || '0') : 300;
        trilho.scrollBy({ left: passo * Number(b.dataset.dir), behavior: 'smooth' });
      }),
    );
  });
</script>

<style>
  .car {
    padding-top: clamp(96px, 12vw, 200px);
  }
  .car__topo {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 16px;
    margin-bottom: clamp(24px, 3vw, 48px);
  }
  .car__cab {
    grid-column: 2;
    text-align: center;
  }
  .car__tit {
    font-size: clamp(1.8rem, 3.4vw, 3.2rem);
    font-weight: 400;
    font-stretch: 106%;
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 10px;
  }
  .car__setas {
    grid-column: 3;
    justify-self: end;
    display: flex;
    gap: 4px;
  }
  .car__seta {
    width: 48px;
    height: 48px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    background: none;
    color: inherit;
    font-size: 18px;
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .car__seta:hover {
    background: var(--ink);
    color: var(--bg);
  }
  .car__trilho {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 2 * var(--g) - 2 * var(--gap)) / 3.25);
    column-gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--g);
    list-style: none;
    margin: 0;
    padding-bottom: 8px;
    scrollbar-width: none;
  }
  .car__trilho::-webkit-scrollbar {
    display: none;
  }
  .car__item {
    scroll-snap-align: start;
  }
  .car__item a {
    display: block;
    text-decoration: none;
  }
  .car__img {
    aspect-ratio: 4 / 5;
    border-radius: var(--raio);
    background: #d6d6d1;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .car__img[data-tom='1'] {
    background: #cbcbc6;
  }
  .car__img[data-tom='2'] {
    background: #dfdfdb;
  }
  .car__item a:hover .car__img {
    transform: translateY(-4px);
  }
  .car__nome {
    display: block;
    text-align: center;
    padding-top: 14px;
    font-size: 12px;
  }
  @media (max-width: 760px) {
    .car__topo {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
    .car__cab {
      grid-column: 1;
      text-align: left;
    }
    .car__setas {
      grid-column: 2;
    }
    .car__trilho {
      grid-auto-columns: 78%;
    }
  }
</style>
