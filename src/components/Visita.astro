---
import { site } from '../data/site';
import Confirmar from './Confirmar.astro';

interface Props {
  titulo?: string;
  nivel?: 'h1' | 'h2';
}
const { titulo = 'Onde fica a loja', nivel = 'h2' } = Astro.props;
const H = nivel;
---

<section class="visita" aria-labelledby="visita-titulo">
  <div class="wrap visita__grade">
    <div class="visita__texto">
      <H id="visita-titulo">{titulo}</H>
      <p class="visita__intro">
        Traga a peça, a foto ou o arquivo no pen drive. Escolher moldura é melhor ao vivo, com a obra
        encostada na amostra.
      </p>

      <dl class="visita__dados">
        <div>
          <dt>Endereço</dt>
          <dd>
            {site.endereco.valor}<br />
            {site.cidade}, {site.uf}{site.cep.valor && <>, CEP {site.cep.valor}</>}
            {!(site.endereco.confirmado && site.cep.confirmado) && <Confirmar />}
          </dd>
        </div>
        <div>
          <dt>Telefone</dt>
          <dd>
            <a href={site.telefoneLink}>{site.telefone.valor}</a>
            {!site.telefone.confirmado && <Confirmar />}
          </dd>
        </div>
        <div>
          <dt>WhatsApp</dt>
          <dd>
            {
              site.whatsappLink ? (
                <a href={site.whatsappLink} rel="noopener">
                  {site.whatsapp.valor}
                </a>
              ) : (
                <span class="visita__vazio">Número a definir</span>
              )
            }
            {!site.whatsapp.confirmado && <Confirmar nota="Sem número de WhatsApp público" />}
          </dd>
        </div>
        <div>
          <dt>Horário</dt>
          <dd>
            {
              site.horario.valor.length ? (
                site.horario.valor.map((h) => (
                  <>
                    {h.dias}: {h.horas}
                    <br />
                  </>
                ))
              ) : (
                <span class="visita__vazio">Horário a definir</span>
              )
            }
            {!site.horario.confirmado && <Confirmar nota="Horário não encontrado em fonte pública" />}
          </dd>
        </div>
        <div>
          <dt>Instagram</dt>
          <dd><a href={site.instagram.url} rel="noopener">{site.instagram.usuario}</a></dd>
        </div>
      </dl>

      <a class="botao botao--claro" href={site.mapaLink} rel="noopener">Abrir no Google Maps</a>
    </div>

    <div class="visita__mapa">
      <iframe
        title="Mapa com a localização da Obra Primma em Ponta Grossa"
        src={site.mapaEmbed}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
</section>

<style>
  .visita {
    background: var(--nogueira);
    color: var(--sobre-escuro);
    padding: clamp(72px, 10vw, 140px) 0;
  }
  .visita__grade {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .visita h1,
  .visita h2 {
    font-size: clamp(2.4rem, 5vw, 4.4rem);
  }
  .visita__intro {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.45;
    margin: 24px 0 40px;
    max-width: 30ch;
    color: #d9cfbf;
  }
  .visita__dados {
    margin: 0 0 40px;
  }
  .visita__dados div {
    display: grid;
    grid-template-columns: 7.5em 1fr;
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid rgba(239, 231, 218, 0.16);
  }
  .visita__dados div:last-child {
    border-bottom: 1px solid rgba(239, 231, 218, 0.16);
  }
  dt {
    font-size: 0.875rem;
    color: #b9ab97;
  }
  dd {
    margin: 0;
  }
  .visita a:not(.botao) {
    text-underline-offset: 0.2em;
  }
  .visita__vazio {
    color: #b9ab97;
  }
  .visita :global(.confirmar) {
    color: #f0a48f;
    border-color: #f0a48f;
  }
  .botao--claro:hover {
    background: var(--sobre-escuro);
    color: var(--nogueira);
    border-color: var(--sobre-escuro);
  }
  .visita__mapa {
    aspect-ratio: 4 / 3.4;
    background: var(--nogueira-2);
    border: 10px solid #4a3a2e;
    box-shadow: 0 30px 50px -30px rgba(0, 0, 0, 0.7);
  }
  .visita__mapa iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(0.35) sepia(0.12);
  }
  @media (max-width: 900px) {
    .visita__grade {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .visita__dados div {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .botao {
      width: 100%;
      justify-content: center;
    }
  }
</style>
