---
import { site } from '../data/site';

interface Props {
  titulo?: boolean;
}
const { titulo = true } = Astro.props;
const horario = site.horario.map((h) => `${h.dias}: ${h.horas}`);
---

<section class="loja pag" aria-labelledby={titulo ? 'loja-titulo' : undefined} aria-label={titulo ? undefined : 'Dados da loja'}>
  {
    titulo && (
      <div class="loja__topo">
        <h2 id="loja-titulo" class="titulo">
          Visite a loja
        </h2>
        <p class="loja__intro">
          Traga a peça, a foto ou o arquivo. Escolher moldura é melhor ao vivo, com a obra encostada na
          amostra.
        </p>
      </div>
    )
  }

  <dl class="loja__dados regua">
    <div>
      <dt class="rotulo cinza">Endereço</dt>
      <dd>
        {site.endereco}<br />{site.cidade}, {site.uf}
      </dd>
    </div>
    <div>
      <dt class="rotulo cinza">Telefone</dt>
      <dd>
        <a href={site.telefoneLink}>{site.telefone}</a>
      </dd>
    </div>
    {
      site.whatsappLink && (
        <div>
          <dt class="rotulo cinza">WhatsApp</dt>
          <dd>
            <a href={site.whatsappLink} rel="noopener">{site.whatsapp}</a>
          </dd>
        </div>
      )
    }
    {
      horario.length > 0 && (
        <div>
          <dt class="rotulo cinza">Horário</dt>
          <dd>{horario.map((h) => <span class="loja__hora">{h}</span>)}</dd>
        </div>
      )
    }
    <div>
      <dt class="rotulo cinza">Instagram</dt>
      <dd><a href={site.instagram.url} rel="noopener">{site.instagram.usuario}</a></dd>
    </div>
  </dl>

  <div class="loja__mapa">
    <iframe
      title="Mapa com a localização da Obra Primma em Ponta Grossa"
      src={site.mapaEmbed}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>
  <p class="loja__abrir"><a class="lk" href={site.mapaLink} rel="noopener">Abrir no Google Maps</a></p>
</section>

<style>
  .loja {
    padding-block: clamp(64px, 9vw, 140px);
  }
  .loja__topo {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px 48px;
    flex-wrap: wrap;
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .loja__intro {
    max-width: 34ch;
    color: var(--mid);
  }
  .loja__dados {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 24px;
    margin: 0;
    padding-top: 12px;
  }
  dt {
    margin-bottom: 8px;
  }
  dd {
    margin: 0;
    font-size: var(--t-corpo);
  }
  .loja__hora {
    display: block;
  }
  dd a {
    text-underline-offset: 3px;
  }
  .loja__mapa {
    border-radius: var(--raio);
    overflow: hidden;
    margin-top: clamp(32px, 4vw, 56px);
    aspect-ratio: 21 / 8;
    background: var(--soft);
  }
  .loja__mapa iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    filter: grayscale(1) contrast(1.05);
  }
  .loja__abrir {
    margin-top: 4px;
  }
  @media (max-width: 1000px) {
    .loja__dados {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .loja__dados {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
    .loja__mapa {
      aspect-ratio: 4 / 5;
    }
  }
</style>
