---
import { site, nav } from '../data/site';
const ano = new Date().getFullYear();
---

<footer class="rod">
  <div class="pag">
    <p class="rod__marca display" aria-hidden="true">Obra <em>Primma</em></p>
    <nav class="rod__nav" aria-label="Rodapé">
      <a class="rotulo" href="/">Início</a>
      {nav.map((i) => <a class="rotulo" href={i.href}>{i.label}</a>)}
      <a class="rotulo" href={site.instagram.url} rel="noopener">Instagram</a>
      <a class="rotulo" href={site.facebook.url} rel="noopener">Facebook</a>
    </nav>
    <div class="rod__fim">
      <p>© {ano} Obra Primma Molduraria, {site.cidade}, {site.uf}</p>
      <p>Molduraria e impressão</p>
    </div>
  </div>
</footer>

<style>
  .rod {
    background: var(--ink);
    color: #ededea;
    padding: clamp(48px, 7vw, 96px) 0 24px;
    overflow: hidden;
  }
  .rod__marca {
    font-size: clamp(3rem, 14.2vw, 15.5rem);
    white-space: nowrap;
    margin-left: -0.04em;
  }
  .rod__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    border-top: 1px solid #3a3a38;
    margin-top: clamp(32px, 4vw, 56px);
    padding-top: 8px;
  }
  .rod__nav a {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .rod__nav a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .rod__fim {
    display: flex;
    justify-content: space-between;
    gap: 16px 40px;
    flex-wrap: wrap;
    margin-top: 32px;
    font-size: 11px;
    color: #8f8f8a;
  }
  .rod__fim p:last-child {
    max-width: 60ch;
  }
  @media (max-width: 760px) {
    .rod__marca {
      white-space: normal;
      font-size: 24vw;
      line-height: 0.82;
    }
  }
  @media (max-width: 560px) {
    .rod__nav {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
