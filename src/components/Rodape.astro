---
import { site, nav } from '../data/site';
const ano = new Date().getFullYear();
---

<footer class="rod">
  <div class="pag">
    <div class="rod__topo">
      <a href="/" class="rod__logo" aria-label="Obra Primma, página inicial">
        <img src="/logo-claro.svg" alt="Obra Primma, quadros e molduras" width="1140" height="885" loading="lazy" />
      </a>
      <div class="rod__cols">
        <nav aria-label="Rodapé">
          <p class="rotulo rod__rot">Páginas</p>
          <a href="/">Início</a>
          {nav.map((i) => <a href={i.href}>{i.label}</a>)}
        </nav>
        <div>
          <p class="rotulo rod__rot">Redes</p>
          <a href={site.instagram.url} rel="noopener">Instagram</a>
          <a href={site.facebook.url} rel="noopener">Facebook</a>
        </div>
        <div>
          <p class="rotulo rod__rot">Loja</p>
          <p>{site.endereco}<br />{site.cidade}, {site.uf}</p>
          <a href={site.telefoneLink}>{site.telefone}</a>
        </div>
      </div>
    </div>
    <div class="rod__fim">
      <p>© {ano} Obra Primma Molduraria</p>
      <p>Quadros e molduras em {site.cidade}</p>
    </div>
  </div>
</footer>

<style>
  .rod {
    background: var(--ameixa);
    color: var(--creme);
    padding: clamp(56px, 7vw, 104px) 0 20px;
  }
  .rod__topo {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px;
    align-items: start;
  }
  .rod__logo img {
    width: clamp(200px, 24vw, 340px);
    height: auto;
  }
  .rod__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  .rod__cols > * {
    display: grid;
    align-content: start;
    gap: 2px;
  }
  .rod__rot {
    color: var(--rosado);
    margin-bottom: 8px;
  }
  .rod a {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    justify-self: start;
    transition: color 0.2s;
  }
  .rod a:hover {
    color: var(--rosa);
  }
  .rod__fim {
    display: flex;
    justify-content: space-between;
    gap: 8px 32px;
    flex-wrap: wrap;
    margin-top: clamp(48px, 6vw, 88px);
    padding-top: 16px;
    border-top: 1px solid var(--linha-escura);
    font-size: var(--t-rotulo);
    color: var(--rosado);
  }
  @media (max-width: 900px) {
    .rod__topo {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .rod__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .rod a {
      min-height: 44px;
    }
  }
</style>
