---
// Um projeto da galeria. Sem `imagem`, vira um bloco cinza do wireframe.
import type { Obra } from '../data/obras';

interface Props {
  obra: Obra;
  proporcao?: string; // ex.: '4 / 5'
  numero?: string; // ex.: '01 / 24'
  tom?: number; // 0, 1 ou 2: varia o cinza para a grade não ficar chapada
}
const { obra, proporcao = '4 / 5', numero, tom = 0 } = Astro.props;
---

<figure class="peca" data-categoria={obra.categoria} data-flip-id={obra.slug}>
  <div class="peca__img" style={`aspect-ratio:${proporcao}`} data-tom={tom}>
    {obra.imagem && <img src={obra.imagem} alt={`${obra.titulo}. ${obra.tipo}.`} loading="lazy" />}
  </div>
  <figcaption>
    <span class="peca__linha">
      <span class="rotulo">{obra.titulo}</span>
      {numero && <span class="peca__num">{numero}</span>}
    </span>
    <span class="peca__tipo">{obra.tipo}</span>
  </figcaption>
</figure>

<style>
  .peca {
    margin: 0;
  }
  .peca__img {
    overflow: hidden;
    border-radius: var(--raio);
    background: var(--ph-1);
  }
  .peca__img[data-tom='1'] {
    background: var(--ph-2);
  }
  .peca__img[data-tom='2'] {
    background: var(--ph-3);
  }
  .peca__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .peca:hover .peca__img img {
    transform: scale(1.03);
  }
  figcaption {
    display: grid;
    gap: 1px;
    padding-top: 10px;
  }
  .peca__linha {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .peca__num {
    font-size: clamp(1.4rem, 2.6vw, 2.6rem);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1;
    white-space: nowrap;
  }
  .peca__tipo {
    font-size: 11px;
    color: var(--mid);
  }
</style>
