---
// Um projeto da galeria. Sem `imagem`, vira um bloco cinza do wireframe.
// Com `imagem`, usa a foto de src/assets/trabalhos/ otimizada pelo Astro (webp, srcset).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Obra } from '../data/obras';

interface Props {
  obra: Obra;
  proporcao?: string; // ex.: '4 / 5'
  tom?: number; // 0, 1 ou 2: varia o cinza para a grade não ficar chapada
  sizes?: string;
}
const { obra, proporcao = '4 / 5', tom = 0, sizes = '(max-width: 760px) 50vw, 33vw' } = Astro.props;

const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/trabalhos/*.{jpg,jpeg,png,webp}', {
  eager: true,
});
const foto = obra.imagem
  ? Object.entries(fotos).find(([c]) => c.split('/').pop()!.startsWith(obra.imagem + '.'))?.[1].default
  : undefined;
---

<figure class="peca" data-categoria={obra.categoria} data-flip-id={obra.slug}>
  <div class="peca__img" style={`aspect-ratio:${proporcao}`} data-tom={tom}>
    {foto && <Image src={foto} alt={`${obra.titulo}. ${obra.tipo}.`} widths={[400, 800, 1200]} sizes={sizes} />}
  </div>
  <figcaption>
    <span class="peca__titulo">{obra.titulo}</span>
    <span class="peca__tipo">{obra.tipo}</span>
  </figcaption>
</figure>

<style>
  .peca {
    margin: 0;
  }
  .peca__img {
    overflow: hidden;
    border-radius: var(--raio);
    background: var(--ph-1);
  }
  .peca__img[data-tom='1'] {
    background: var(--ph-2);
  }
  .peca__img[data-tom='2'] {
    background: var(--ph-3);
  }
  .peca__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  figcaption {
    display: grid;
    gap: 2px;
    padding-top: 12px;
  }
  .peca__titulo {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
  }
  .peca__tipo {
    font-size: var(--t-legenda);
    line-height: 1.35;
    color: var(--mid);
  }
</style>
