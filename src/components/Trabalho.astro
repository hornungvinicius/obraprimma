---
// Um item do catálogo: um quadro (ou um conjunto) e a legenda curta de oficina.
import Quadro from './Quadro.astro';
import { molduras, type Obra } from '../data/obras';

interface Props {
  obra: Obra;
  sizes?: string;
  eager?: boolean;
}
const { obra, sizes, eager } = Astro.props;
const m = molduras[obra.pecas[0].moldura];
const passe = obra.pecas[0].passe;
const detalhe = [
  obra.suporte,
  passe === 'flutuante' ? 'caixa flutuante' : passe !== 'nenhum' ? `passe-partout ${passe}` : null,
  `moldura ${m.nome.toLowerCase()}`,
]
  .filter(Boolean)
  .join(', ');
const alt = `${obra.titulo}, de ${obra.autor}. ${detalhe}.`;
---

<figure class="trab" data-categoria={obra.categoria}>
  {
    obra.pecas.length > 1 ? (
      <div class="trab__conjunto" style={`--n:${obra.pecas.length}`}>
        {obra.pecas.map((p, i) => (
          <Quadro
            {...p}
            alt={i === 0 ? alt : ''}
            sizes={sizes ?? '(max-width: 760px) 30vw, 18vw'}
            eager={eager}
          />
        ))}
      </div>
    ) : (
      <Quadro {...obra.pecas[0]} foto={obra.foto} alt={alt} sizes={sizes} eager={eager} />
    )
  }
  <figcaption>
    <span class="trab__titulo">{obra.titulo}</span>
    <span class="trab__autor">{obra.autor}</span>
    <span class="meta">{detalhe}</span>
  </figcaption>
</figure>

<style>
  .trab {
    margin: 0;
  }
  .trab__conjunto {
    display: flex;
    align-items: flex-start;
    gap: 6%;
  }
  .trab__conjunto > :global(*) {
    flex: 1;
  }
  figcaption {
    margin-top: 22px;
    display: grid;
    gap: 2px;
  }
  .trab__titulo {
    font-family: var(--serif);
    font-size: 1.05rem;
    line-height: 1.3;
  }
  .trab__autor {
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--tinta-2);
  }
  .meta {
    margin-top: 4px;
  }
</style>
